# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit tokens.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Turnstile site key is public and is included in the frontend bundle.
VITE_TURNSTILE_SITE_KEY=
# These two values are server-only. Never prefix the secret with VITE_.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
